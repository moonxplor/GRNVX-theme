{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/moonxplor/.config/fastfetch/garuda_custom.txt",
    "type": "file",
    "color": {
      "1": "green",
      "2": "green"
    },
    "padding": {
      "top": 0,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "    ",
    "color": {
      "separator": "green"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "  {user-name-colored}{at-symbol-colored}{host-name-colored}",
      "color": {
        "user": "green",
        "at": "white",
        "host": "bright_green"
      }
    },
    {
      "type": "custom",
      "format": "  ──────────────────────────────────────",
      "outputColor": "green"
    },
    {
      "type": "os",
      "key": "  󰣇",
      "keyColor": "green"
    },
    {
      "type": "kernel",
      "key": "  󰌽",
      "keyColor": "green"
    },
    {
      "type": "uptime",
      "key": "  󱎫",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": "  󰏖",
      "keyColor": "green"
    },
    {
      "type": "shell",
      "key": "  󰞷",
      "keyColor": "green"
    },
    {
      "type": "de",
      "key": "  󰧨",
      "keyColor": "bright_green"
    },
    {
      "type": "wm",
      "key": "  󱂬",
      "keyColor": "bright_green"
    },
    {
      "type": "theme",
      "key": "  󰉼",
      "keyColor": "bright_green",
      "format": "{theme1~0,6} [Qt]"
    },
    {
      "type": "terminal",
      "key": "  󰞌",
      "keyColor": "bright_green"
    },
    {
      "type": "cpu",
      "key": "  󰻠",
      "keyColor": "yellow",
      "format": "{name~18} @ {freq-max}"
    },
    {
      "type": "gpu",
      "key": "  󰢮",
      "keyColor": "yellow",
      "format": "{name}{?frequency} @ {frequency}{?}"
    },
    {
      "type": "memory",
      "key": "  󰍛",
      "keyColor": "yellow"
    },
    {
      "type": "battery",
      "key": "  󰁹",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": "  ──────────────────────────────────────",
      "outputColor": "green"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}
