{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/moonxplor/.config/fastfetch/garuda_custom.txt",
    "type": "file",
    "color": {
      "1": "green",
      "2": "green"
    },
    "padding": {
      "top": 0,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "    ",
    "color": {
      "separator": "green"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "  {user-name-colored}{at-symbol-colored}{host-name-colored}",
      "color": {
        "user": "green",
        "at": "white",
        "host": "bright_green"
      }
    },
    {
      "type": "custom",
      "format": "  ──────────────────────────────────────",
      "outputColor": "green"
    },
    {
      "type": "os",
      "key": "  󰣇 OS",
      "keyColor": "green"
    },
    {
      "type": "kernel",
      "key": "  󰌽 Kernel",
      "keyColor": "green"
    },
    {
      "type": "uptime",
      "key": "  󱎫 Uptime",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": "  󰏖 Packages",
      "keyColor": "green"
    },
    {
      "type": "shell",
      "key": "  󰞷 Shell",
      "keyColor": "green"
    },
    {
      "type": "de",
      "key": "  󰧨 Desktop",
      "keyColor": "bright_green"
    },
    {
      "type": "wm",
      "key": "  󱂬 Window Mgr",
      "keyColor": "bright_green"
    },
    {
      "type": "theme",
      "key": "  󰉼 Palette",
      "keyColor": "bright_green"
    },
    {
      "type": "terminal",
      "key": "  󰞌 Terminal",
      "keyColor": "bright_green"
    },
    {
      "type": "cpu",
      "key": "  󰻠 CPU",
      "keyColor": "yellow"
    },
    {
      "type": "gpu",
      "key": "  󰢮 GPU",
      "keyColor": "yellow"
    },
    {
      "type": "memory",
      "key": "  󰍛 Memory",
      "keyColor": "yellow"
    },
    {
      "type": "battery",
      "key": "  󰁹 Battery",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": "  ──────────────────────────────────────",
      "outputColor": "green"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}
